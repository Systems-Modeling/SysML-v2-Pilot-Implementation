package RedefinitionEnd {
	classifier A {
		end feature e[1];
	}
	
	classifier B :> A {
		feature :>> e;
	}
	
	assoc R {
		end a : A;
		end b : B;
	}
	
	abstract connector r : R {
		end a;
		end b;
	}
	
	abstract assoc R1 :> R {
		// XPECT errors ---> "Redefining feature must be an end feature" at "a"
		feature a1 :>> a;
	}
	
	abstract connector r1 :> r {
		// XPECT errors ---> "Redefining feature must be an end feature" at "a"
		feature a1 :>> a;
	}

}